# Environment variables — copy this to .env.local and fill in your values
# .env.local is git-ignored and should NEVER be committed to version control

# Required for Google Drive backup: Service Account credentials
# Option A — paste the entire JSON key file as a single-line string:
#   GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}'
#
# Option B — provide the path to the downloaded JSON key file instead:
#   GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/to/service-account.json
#
# How to get one:
#   1. Go to https://console.cloud.google.com/ → select your project
#   2. Enable the "Google Drive API" in APIs & Services → Library
#   3. Go to APIs & Services → Credentials → Create Service Account
#   4. Download the JSON key file for the new service account
#   5. Paste the contents as GOOGLE_SERVICE_ACCOUNT_JSON below (Option A)
#      OR place the file somewhere safe and use GOOGLE_SERVICE_ACCOUNT_KEY_FILE (Option B)
#   6. (Optional) Share a Drive folder with the service account email (client_email in the JSON)
#      and give it Editor access — the app will use that folder for backup files
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: Enables automatic data extraction from uploaded invoice images
# Get a key at https://platform.openai.com/
# Without this, uploaded invoices will have blank fields you fill in manually
OPENAI_API_KEY=
